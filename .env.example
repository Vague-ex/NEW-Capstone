# Deployment settings read by docker-compose.yml. Copy to .env beside the
# compose file and fill in:  cp .env.example .env
#
# .env is gitignored. Never commit the filled-in copy.

# The domain claimed in hPanel (free for the first year with the VPS).
# Caddy requests certificates for BOTH this name and api.<this name>, so
# both need DNS A records pointing at the VPS before you start the stack.
SITE_DOMAIN=gradtracer.tech

# Where Let's Encrypt sends expiry and problem notices. Use a real inbox.
ACME_EMAIL=you@example.com

# NEXT_PUBLIC_* is baked into the frontend bundle at BUILD time, not read at
# runtime. Changing this needs "up -d --build", not just a restart.
NEXT_PUBLIC_API_URL=https://api.gradtracer.tech

# ── Face engine (optional) ───────────────────────────────────────────────────
# Leave these alone for the default browser-side face-api.js engine.
#
# Set INSTALL_INSIGHTFACE=true to build an image with server-side recognition,
# then set FACE_ENGINE=insightface in backend/.env. See section 7b of DEPLOY.md.
#
# Workers matter here: each one holds its own ONNX session at roughly
# 0.8-1.5 GB, and two on a 4 GB box get OOM-killed. One worker with threads
# costs nothing on a workload that waits on Supabase.
INSTALL_INSIGHTFACE=false
INSIGHTFACE_MODEL_PACK=buffalo_s
GUNICORN_WORKERS=2
GUNICORN_THREADS=1
