# Secrets must never enter the image — they are supplied at runtime instead.
.env
.env.*
*.pem
*.key

# Local virtualenvs: wrong platform, and huge.
venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# Local database and collected output; regenerated in the image.
db.sqlite3
staticfiles/
media/

# Generated plots are build-time only. The trained model artifacts
# (.joblib, model_metadata.json) ARE needed at runtime and are not excluded.
#
# ml/data/*.csv is also needed at runtime: the admin analytics endpoint reads
# processed_training_data.csv to compare live graduates against the training
# distribution (tracer/api.py, _load_ml). Excluding it makes that page fail
# with "missing processed training data". The corpus is synthetic (230 rows,
# ~20KB, no PII), so shipping it costs nothing. Revisit this if the model is
# ever retrained on real alumni records.
ml/models/reports/

.pytest_cache/
.coverage
htmlcov/
