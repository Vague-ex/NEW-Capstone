# Secrets must never enter the image — they are supplied at runtime instead.
.env
.env.*
*.pem
*.key

# Local virtualenvs: wrong platform, and huge.
venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# Local database and collected output; regenerated in the image.
db.sqlite3
staticfiles/
media/

# Trained model versions (ml/models/employability/<version>/model.joblib and
# metadata.json, plus active.json) ARE needed at runtime and are not excluded:
# without them the analytics page has no model and shows observed values only.
#
# The old 30-feature artifacts and the synthetic training corpus (ml/data/*.csv)
# were deleted along with the pipeline that read them.

.pytest_cache/
.coverage
htmlcov/
