# Django
DEBUG=False
SECRET_KEY=replace-with-a-strong-random-secret
ALLOWED_HOSTS=your-backend.up.railway.app

# CORS/CSRF for frontend domain
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
CSRF_TRUSTED_ORIGINS=https://your-frontend.vercel.app
CORS_ALLOW_ALL_ORIGINS=False

# HTTPS/Security
SECURE_SSL_REDIRECT=True
DB_PREFER_POOLER=True

# Database (Railway Postgres or external Postgres)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_POOLER_URL=

# Supabase (required for face storage/integration)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=faceid-verification

# Email transport.
# Branch convention:
#   main branch (localhost):    fill EMAIL_HOST_USER + EMAIL_HOST_PASSWORD
#                               below and leave RESEND_API_KEY blank.
#   test-prod branch (Render):  fill RESEND_API_KEY below and leave
#                               EMAIL_HOST_USER blank.
# email_send.py picks the path automatically: Resend is preferred when
# RESEND_API_KEY is set; otherwise Django SMTP is used. The two paths
# are mutually exclusive.
EMAIL_BACKEND=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Password reset policy
PASSWORD_RESET_CODE_TTL_SECONDS=900
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_CODE_LENGTH=12
PASSWORD_RESET_MAX_ATTEMPTS=5

# Login throttle policy (after N fails, cooldown ramps up per the list).
LOGIN_THROTTLE_FAIL_LIMIT=5
LOGIN_THROTTLE_BACKOFF_SECONDS=15,30,60,120,300,600
# Per-IP ceiling across all emails (campus Wi-Fi shares one IP, keep it generous).
LOGIN_IP_FAIL_LIMIT=30
LOGIN_IP_WINDOW_SECONDS=900

# Public graduate-facing URL (Vercel). Used in transactional email CTAs.
GRADUATE_LOGIN_URL=https://chmsu-alumni-gradtracer.vercel.app/

# Resend HTTPS API. Set RESEND_API_KEY on Render where outbound SMTP is
# blocked. When set, transactional emails go through Resend instead of
# the SMTP backend above. https://resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=
EMAIL_LOGO_URL=

# ── Face recognition engine ──────────────────────────────────────────────────
# Which engine turns a face into a vector. Leave unset for the current
# behaviour; the default is the browser-side face-api.js the system shipped
# with, so an existing deployment is unaffected.
#
#   faceapi      (default) face-api.js in the browser, 128-d, euclidean
#   insightface  server-side ArcFace, 512-d, cosine  -- needs
#                requirements-insightface.txt, and see the memory note in it
#   compreface   separate REST service, 512-d, cosine -- LOCAL COMPARISON ONLY,
#                it wants ~8 GB and will not fit the production VPS
#
# CHANGING THIS INVALIDATES EVERY ENROLLED FACE. Embeddings from different
# engines are not comparable, so templates record which engine made them and
# login returns 409 telling the graduate to re-enrol rather than silently
# falling back to a weaker check.
FACE_ENGINE=faceapi

# Distance at or below which two faces count as the same person. The scales are
# NOT interchangeable: face-api is euclidean where different people sit at
# 0.60+, ArcFace is cosine where they sit at 0.45+.
FACE_DESCRIPTOR_DISTANCE_THRESHOLD=0.55
INSIGHTFACE_DISTANCE_THRESHOLD=0.40
INSIGHTFACE_MODEL_PACK=buffalo_s

# CompreFace, local development only.
COMPREFACE_URL=http://localhost:8000
COMPREFACE_RECOGNITION_KEY=
COMPREFACE_DISTANCE_THRESHOLD=0.40
