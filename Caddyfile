# TLS termination for the Graduate Tracer System.
#
# Caddy obtains and renews Let's Encrypt certificates automatically. This is
# what makes the face-capture and geolocation modules work at all: getUserMedia
# and navigator.geolocation are secure-context APIs, and browsers do not expose
# them to a page served over plain HTTP or from a bare IP address.
#
# Caddy sets X-Forwarded-Proto on every proxied request, which is the header
# SECURE_PROXY_SSL_HEADER in core/settings.py relies on to see requests as
# secure. Changing one without the other will break CSRF on all POSTs.

{
	email {$ACME_EMAIL}
}

# --- Security headers shared by every site block ---
# Set here, at the edge, so they cover every response: pages, static files,
# errors, and the API. App-specific headers (Content-Security-Policy,
# Permissions-Policy, X-Frame-Options) live in frontend/next.config.ts, where
# they can be tested locally.
#
# HSTS has no `preload` on purpose: the preload list is effectively permanent,
# and includeSubDomains alone already covers www and api, which are HTTPS-only.
# The removed headers only advertised the software stack (OWASP ZAP finding).
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-X-Powered-By
		-Server
	}
}

# --- www redirect ---
# A CNAME for www points at the apex. Without a site block here Caddy would
# have no certificate for that name, so anyone typing www.<domain> would get
# a TLS warning rather than the site. Redirect it to the canonical apex.
www.{$SITE_DOMAIN} {
	import security_headers
	redir https://{$SITE_DOMAIN}{uri} permanent
}

# --- Frontend (Next.js) ---
{$SITE_DOMAIN} {
	import security_headers
	encode zstd gzip

	# The app answers every unknown path with its own page, so probes for
	# /.env, /.git or /.hg returned the login page with 200. Nothing was ever
	# exposed, but scanners report it as a leak. Dot-paths get a real 404;
	# /.well-known stays reachable for standard discovery files.
	@dotfiles {
		path /.*
		not path /.well-known/*
	}
	respond @dotfiles 404

	# Static assets are read-only. Writes to them reached the Next.js server
	# and came back as a bare 500; answer 405 Method Not Allowed instead.
	@static_write {
		not method GET HEAD
		path /_next/static/* /modern-face-models/* /*.png /*.ico /*.webmanifest /*.mp3
	}
	respond @static_write 405

	reverse_proxy frontend:3000
}

# --- Backend (Django / gunicorn) ---
api.{$SITE_DOMAIN} {
	import security_headers
	encode zstd gzip

	# Caddy places no limit on request bodies by default. This is an explicit
	# ceiling so one oversized upload cannot exhaust memory, set well above
	# the largest ID photo and face-descriptor payload registration sends.
	request_body {
		max_size 25MB
	}

	# Django's built-in admin and the temporary debug routes stay off the
	# public internet. The admin portal on the main domain is unaffected.
	# Django admin is still reachable through an SSH tunnel to 127.0.0.1:8000.
	# Comment these two lines out (and restart Caddy) to use the debug pages.
	@internal path /admin /admin/* /api/admin/debug/*
	respond @internal 404

	reverse_proxy backend:8000
}
